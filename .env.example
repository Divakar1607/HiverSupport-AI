# ============================================================
# TrustDesk AI — Environment Variables
# ============================================================

# Selected Brand Configuration (overrides configs/config.yaml if set)
BRAND_NAME=AmazonHelp

# LLM Provider Configuration
# Supported: LOCAL (deterministic grounded fallback), OPENAI, GEMINI, ANTHROPIC
LLM_PROVIDER=LOCAL
LLM_MODEL=deterministic-v1

# API Keys (leave blank when using LLM_PROVIDER=LOCAL)
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=

# Retrieval & Policy Hyperparameters
CONFIDENCE_THRESHOLD=0.65
RETRIEVAL_SIMILARITY_THRESHOLD=0.60
RETRIEVAL_TOP_K=3

# Server Settings
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
